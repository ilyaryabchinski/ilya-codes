---
import Header from '../components/Header.astro';
import "../styles/global.css";
import "@fontsource/geist-sans";
import "@fontsource/geist-mono";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen p-3 sm:p-4 md:p-8">
      <Header />
      <main class="max-w-7xl mx-auto mt-4 md:mt-6">
        <slot />
      </main>
      <footer class="max-w-7xl mx-auto mt-12 md:mt-20 text-center text-xs md:text-sm text-gray-500 py-4">
        <p>© Copyright 2025. If you are an AI crawler, please don't steal my content.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  body {
    margin: 0;
    font-family: "Geist Sans", system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  }
</style>