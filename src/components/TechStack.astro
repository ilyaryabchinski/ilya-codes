---
const technologies = [
  {
    name: 'React',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg'
  },
  {
    name: 'Next.js',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg'
  },
  {
    name: 'Angular',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/angular/angular-original.svg'
  },
  {
    name: 'TypeScript',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg'
  },
  {
    name: 'Golang',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original-wordmark.svg'
  },
  {
    name: 'MongoDB',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg'
  },
  {
    name: 'PostgreSQL',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg'
  },
  {
    name: 'Google Cloud',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg'
  },
  {
    name: 'Docker',
    logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg'
  }
];
---
<section id="tech-stack" class="py-20 px-4 md:px-8 bg-gradient-to-b from-gray-900 to-gray-800">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-4xl font-bold text-center mb-16 text-white">Tech Stack</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-8">
      {technologies.map(tech => (
        <div class="group bg-gray-800 p-8 rounded-xl shadow-lg transform hover:scale-105 transition-all duration-300 hover:shadow-2xl border border-gray-700">
          <div class="flex flex-col items-center">
            <img 
              src={tech.logo} 
              alt={`${tech.name} logo`} 
              class="w-16 h-16 mb-4"
            />
            <h3 class="text-xl font-semibold text-white group-hover:text-purple-400 transition-colors">
              {tech.name}
            </h3>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>