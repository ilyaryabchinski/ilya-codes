---
const pathname = new URL(Astro.request.url).pathname;
const isProjectsPage = pathname.startsWith('/projects');
const isPostsPage = pathname.startsWith('/posts');
---
<script is:inline>
  if (
    localStorage.getItem('theme') === 'dark' ||
    (!('theme' in localStorage) &&
      window.matchMedia('(prefers-color-scheme: dark)').matches)
  ) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>

<div class="w-full relative">
  <header class="glass-nav max-w-7xl mx-auto rounded-2xl py-3 md:py-4 px-4 md:px-6 transition-all duration-200 ease-in-out">
    <nav class="flex justify-between items-center">
      <a href="/" class="flex items-center text-lg md:text-xl font-bold text-[color:var(--text-primary)]">
        Ilya Codes 👨‍💻
      </a>

      <!-- Desktop navigation (hidden on mobile) -->
      <div class="hidden md:flex items-center gap-1 px-2 py-1 rounded-xl glass-nav-inner">
        <a href="/projects" class:list={[
          "nav-link flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200",
          isProjectsPage ? "nav-link-active" : ""
        ]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
          </svg>
          Projects
        </a>
        <a href="/posts" class:list={[
          "nav-link flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200",
          isPostsPage ? "nav-link-active" : ""
        ]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          Posts
        </a>
      </div>

      <div class="flex items-center gap-2">
        <!-- Burger menu (mobile only) -->
        <button id="burger-menu-btn" class="glass-icon-btn md:hidden" aria-label="Open menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
        <!-- Theme toggle -->
        <button id="theme-toggle" class="glass-icon-btn" aria-label="Toggle theme">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dark-icon block dark:hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="light-icon hidden dark:block">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </nav>
  </header>

  <!-- Mobile menu -->
  <section id="mobile-menu" class="mobile-menu-section hidden w-full z-40 rounded-b-2xl overflow-hidden glass-nav-mobile">
    <a href="/projects" class:list={[
      "mobile-nav-item flex items-center gap-3 px-6 py-4 text-base font-medium transition-all duration-200 border-b",
      isProjectsPage ? "text-[color:var(--accent-yellow)]" : "text-[color:var(--text-primary)]"
    ]}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
      </svg>
      Projects
    </a>
    <a href="/posts" class:list={[
      "mobile-nav-item flex items-center gap-3 px-6 py-4 text-base font-medium transition-all duration-200",
      isPostsPage ? "text-[color:var(--accent-yellow)]" : "text-[color:var(--text-primary)]"
    ]}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
      </svg>
      Posts
    </a>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    }
    const burgerBtn = document.getElementById('burger-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (burgerBtn && mobileMenu) {
      burgerBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  });
</script>

<style>
  .glass-nav {
    background: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.50);
    box-shadow: 0 4px 24px rgba(31, 38, 135, 0.10), inset 0 1px 0 rgba(255,255,255,0.6);
  }

  :global(.dark) .glass-nav {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .glass-nav-inner {
    background: rgba(255, 255, 255, 0.20);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  :global(.dark) .glass-nav-inner {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.10);
  }

  .nav-link {
    color: var(--text-primary);
    opacity: 0.75;
  }

  .nav-link:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.35);
    color: var(--text-primary);
    transform: translateY(-1px);
  }

  :global(.dark) .nav-link:hover {
    background: rgba(255, 255, 255, 0.10);
  }

  .nav-link-active {
    opacity: 1;
    color: var(--accent-yellow);
    background: rgba(217, 119, 6, 0.12);
    border: 1px solid rgba(217, 119, 6, 0.25);
    font-weight: 600;
  }

  :global(.dark) .nav-link-active {
    color: var(--accent-yellow);
    background: rgba(255, 214, 10, 0.10);
    border-color: rgba(255, 214, 10, 0.20);
  }

  .glass-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.40);
    color: var(--text-primary);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .glass-icon-btn:hover {
    background: rgba(255, 255, 255, 0.38);
    border-color: rgba(255, 255, 255, 0.65);
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    transform: translateY(-1px);
  }

  :global(.dark) .glass-icon-btn {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.12);
  }

  :global(.dark) .glass-icon-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .glass-nav-mobile {
    background: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.50);
    border-top: none;
    box-shadow: 0 8px 24px rgba(31, 38, 135, 0.10);
  }

  :global(.dark) .glass-nav-mobile {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .mobile-nav-item {
    border-color: var(--glass-border);
  }

  .mobile-nav-item:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  :global(.dark) .mobile-nav-item:hover {
    background: rgba(255, 255, 255, 0.07);
  }
</style>
