---
const pathname = new URL(Astro.request.url).pathname;
const isProjectsPage = pathname.startsWith('/projects');
const isPostsPage = pathname.startsWith('/posts');
---
<script is:inline>
  if (
    localStorage.getItem('theme') === 'dark' ||
    (!('theme' in localStorage) &&
      window.matchMedia('(prefers-color-scheme: dark)').matches)
  ) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>

<div class="w-full relative">
  <header class="max-w-7xl mx-auto rounded-2xl py-3 md:py-4 px-4 md:px-6 bg-[var(--card-bg)] border border-[var(--border-color)] shadow-xs transition-all duration-200 ease-in-out dark:bg-[var(--card-bg)] dark:border-[var(--border-color)] dark:shadow-xs">
    <nav class="flex justify-between items-center">
      <a href="/" class="flex items-center text-lg md:text-xl font-bold text-[color:var(--text-primary)] dark:text-[color:var(--text-primary)]">
        Ilya Codes 👨‍💻
      </a>
      <!-- Desktop navigation (hidden on mobile) -->
      <div class="md:flex items-center px-2 py-1 gap-2 rounded-lg bg-transparent transition-all duration-200 ease-in-out hidden md:flex dark:bg-[var(--card-bg)]">
        <a href="/projects" class="px-3 py-1 mx-1 transition-all flex items-center rounded-sm font-medium shadow-xs bg-transparent opacity-80 hover:opacity-100 hover:text-black hover:bg-[var(--accent-yellow)] hover:-translate-y-0.5 hover:shadow-sm active:opacity-100 focus:outline-hidden focus:ring-2 focus:ring-[var(--accent-yellow)] dark:hover:bg-[var(--accent-yellow)] dark:hover:text-black dark:focus:ring-[var(--accent-yellow)] dark:active:text-[color:var(--accent-yellow)] dark:active:bg-transparent dark:active:shadow-none dark:active:opacity-100 dark:focus:outline-hidden dark:focus:ring-2 dark:focus:ring-[var(--accent-yellow)] dark:shadow-xs/20 dark:bg-transparent border-none box-shadow-none transition-all duration-300 ease-in-out">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
          </svg>
          Projects
        </a>
        <a href="/posts" class="px-3 py-1 mx-1 transition-all flex items-center rounded-sm font-medium shadow-xs bg-transparent opacity-80 hover:opacity-100 hover:text-black hover:bg-[var(--accent-yellow)] hover:-translate-y-0.5 hover:shadow-sm active:opacity-100 focus:outline-hidden focus:ring-2 focus:ring-[var(--accent-yellow)] dark:hover:bg-[var(--accent-yellow)] dark:hover:text-black dark:focus:ring-[var(--accent-yellow)] dark:active:text-[color:var(--accent-yellow)] dark:active:bg-transparent dark:active:shadow-none dark:active:opacity-100 dark:focus:outline-hidden dark:focus:ring-2 dark:focus:ring-[var(--accent-yellow)] dark:shadow-xs/20 dark:bg-transparent border-none box-shadow-none transition-all duration-300 ease-in-out">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          Posts
        </a>
      </div>
      <div class="flex items-center space-x-2">
        <!-- Burger menu button (mobile only) -->
        <button id="burger-menu-btn" class="burger-menu-btn theme-toggle-btn md:hidden flex items-center justify-center w-9 h-9 rounded-md bg-[var(--card-bg)] border border-[var(--border-color)] text-[color:var(--text-primary)] transition-all duration-300 hover:bg-[var(--accent-yellow)] hover:text-black hover:-translate-y-0.5 focus:outline-hidden focus:ring-2 focus:ring-[var(--accent-yellow)] dark:bg-[var(--card-bg)] dark:border-[var(--border-color)] dark:text-[color:var(--text-primary)] dark:hover:bg-[var(--accent-yellow)] dark:hover:text-black dark:focus:ring-[var(--accent-yellow)]" aria-label="Open menu">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
        <button id="theme-toggle" class="theme-toggle-btn flex items-center justify-center w-9 h-9 rounded-md bg-[var(--card-bg)] border border-[var(--border-color)] text-[color:var(--text-primary)] transition-all duration-300 hover:bg-[var(--accent-yellow)] hover:text-black hover:-translate-y-0.5 focus:outline-hidden focus:ring-2 focus:ring-[var(--accent-yellow)] dark:bg-[var(--card-bg)] dark:border-[var(--border-color)] dark:text-[color:var(--text-primary)] dark:hover:bg-[var(--accent-yellow)] dark:hover:text-black dark:focus:ring-[var(--accent-yellow)]" aria-label="Toggle theme">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dark-icon block dark:hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="light-icon hidden dark:block">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
      </div>
    </nav>
  </header>
  <!-- Mobile menu (hidden by default, shown when burger is active) -->
  <section id="mobile-menu" class="mobile-menu-section hidden w-full static z-40 rounded-b-2xl shadow-lg bg-[var(--card-bg)] border border-[var(--border-color)] transition-all dark:bg-[var(--card-bg)] dark:border-[var(--border-color)]">
    <a href="/projects" class="mobile-nav-item block px-6 py-4 border-b border-[var(--border-color)] flex items-center text-[1.15rem] font-medium rounded-md bg-[var(--card-bg)] border border-[var(--border-color)] transition-all duration-200 hover:bg-[var(--hover-card-bg)] hover:-translate-x-1 active:text-[color:var(--accent-yellow)] active:border-[var(--accent-yellow)] active:bg-[var(--accent-yellow)]/10 dark:active:bg-[var(--accent-yellow)]/10">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 align-middle inline-block">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
      </svg>
      Projects
    </a>
    <a href="/posts" class="mobile-nav-item block px-6 py-4 border-b border-[var(--border-color)] flex items-center text-[1.15rem] font-medium rounded-md bg-[var(--card-bg)] border border-[var(--border-color)] transition-all duration-200 hover:bg-[var(--hover-card-bg)] hover:-translate-x-1 active:text-[color:var(--accent-yellow)] active:border-[var(--accent-yellow)] active:bg-[var(--accent-yellow)]/10 dark:active:bg-[var(--accent-yellow)]/10">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 align-middle inline-block">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
      </svg>
      Posts
    </a>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    }
    // Burger menu toggle
    const burgerBtn = document.getElementById('burger-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (burgerBtn && mobileMenu) {
      burgerBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  });
</script>