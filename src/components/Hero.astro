---
---
<section class="min-h-screen px-4 md:px-8 bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900 text-white flex items-center">
    <div class="max-w-6xl mx-auto text-center relative">
      <div class="animate-float">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-400">
          Software Engineer
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-12 max-w-2xl mx-auto">
          Crafting elegant solutions to complex problems with modern technologies
        </p>
        <div class="flex gap-6 justify-center">
          <a href="#contact" class="group relative px-8 py-3 rounded-lg text-lg font-medium overflow-hidden">
            <div class="absolute inset-0 w-full h-full transition-all duration-300 ease-out transform translate-x-0 -skew-x-12 bg-purple-500 group-hover:bg-purple-700"></div>
            <span class="relative">Get in Touch</span>
          </a>
          <a href="#tech-stack" class="group relative px-8 py-3 rounded-lg text-lg font-medium overflow-hidden">
            <div class="absolute inset-0 w-full h-full transition-all duration-300 ease-out transform translate-x-0 -skew-x-12 bg-blue-600 group-hover:bg-blue-700"></div>
            <span class="relative">View Tech Stack</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <style>
    .animate-float {
      animation: float 6s ease-in-out infinite;
    }
    
    @keyframes float {
      0% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
      100% {
        transform: translateY(0px);
      }
    }
  </style>