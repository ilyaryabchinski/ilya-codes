---
import eslFaceitGroupLogo from '../assets/esl-faceit-group.png';
import haiiloLogo from '../assets/haiilo.png';
import samSolutionsLogo from '../assets/sam-solutions.png';

const workExperiences = [
  {
    logo: eslFaceitGroupLogo.src,
    alt: "ESL FACEIT Group Logo",
    company: "ESL FACEIT Group",
    position: "Software Engineer - Frontend",
    years: "2022 - now",
  },
  {
    logo: haiiloLogo.src,
    alt: "Haiilo Logo",
    company: "Haiilo",
    position: "Frontend Engineer",
    years: "2020 - 2022",
  },
  {
    logo: samSolutionsLogo.src,
    alt: "Sam Solutions Logo",
    company: "Sam Solutions",
    position: "Front-End Software Developer",
    years: "2018 - 2020",
  },
];
---

<section class="bento-card h-full p-5 md:p-7">
  <p class="eyebrow mb-3">Selected timeline</p>
  <h2 class="section-heading mb-7">Work experience</h2>
  
  <div class="timeline">
    {workExperiences.map(experience => (
      <article class="timeline-item">
        <img src={experience.logo} alt={experience.alt} class="company-logo" width="44" height="44" loading="lazy" />
        <div>
          <h3 class="font-medium">{experience.company}</h3>
          <p class="section-copy mt-1">{experience.position}</p>
        </div>
        <p class="timeline-date">{experience.years}</p>
      </article>
    ))}
  </div>
</section>
