---
import eslFaceitGroupLogo from '../assets/esl-faceit-group.png';
import haiiloLogo from '../assets/haiilo.png';
import samSolutionsLogo from '../assets/sam-solutions.png';

const workExperiences = [
  {
    logo: eslFaceitGroupLogo.src,
    alt: "ESL FACEIT Group Logo",
    company: "ESL FACEIT Group",
    position: "Software Engineer - Frontend",
    years: "2022 - now",
  },
  {
    logo: haiiloLogo.src,
    alt: "Haiilo Logo",
    company: "Haiilo",
    position: "Frontend Engineer",
    years: "2020 - 2022",
  },
  {
    logo: samSolutionsLogo.src,
    alt: "Sam Solutions Logo",
    company: "Sam Solutions",
    position: "Front-End Software Developer",
    years: "2018 - 2020",
  },
];
---

<div class="bento-card p-4 md:p-6 h-full">
  <div class="flex justify-between items-center mb-4 md:mb-6">
    <h2 class="text-xl font-bold text-[color:var(--text-primary)]">Work Experience</h2>
    <span class="glass-badge">{workExperiences.length} roles</span>
  </div>

  <div class="space-y-4 md:space-y-5">
    {workExperiences.map((experience, i) => (
      <div>
        <div class="flex items-center gap-4">
          <!-- Company logo with glass container -->
          <div class="work-logo-wrap flex-shrink-0 w-11 h-11 rounded-xl flex items-center justify-center overflow-hidden">
            <img src={experience.logo} alt={experience.alt} class="w-8 h-8 object-contain" />
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-2 flex-wrap">
              <h3 class="font-semibold text-[color:var(--text-primary)] leading-tight">{experience.company}</h3>
              <span class="glass-badge flex-shrink-0">{experience.years}</span>
            </div>
            <p class="text-sm text-[color:var(--text-secondary)] mt-0.5">{experience.position}</p>
          </div>
        </div>
        {i < workExperiences.length - 1 && (
          <div class="glass-separator mt-4" />
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .work-logo-wrap {
    background: rgba(255, 255, 255, 0.30);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.50);
    box-shadow: 0 2px 8px rgba(31, 38, 135, 0.08);
  }

  :global(.dark) .work-logo-wrap {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
</style>
