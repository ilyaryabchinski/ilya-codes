---
import FullStack from './FullStack.astro';
import Contacts from './Contacts.astro';
import PetProjects from './PetProjects.astro';
import Posts from './Posts.astro';
---
<section class="grid grid-cols-1 gap-4 lg:gap-6">
  <!-- Full-stack overview -->
  <div>
    <FullStack />
  </div>

  <!-- Contacts -->
  <div>
    <Contacts />
  </div>

  <!-- Pet Projects and Posts -->
  <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-6">
    <div class="md:col-span-6">
      <PetProjects />
    </div>
    <div class="md:col-span-6">
      <Posts />
    </div>
  </div>
</section>
