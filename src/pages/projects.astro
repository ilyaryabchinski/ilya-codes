---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Projects">
  <section aria-labelledby="projects-title">
    <header class="project-page-header">
      <p class="eyebrow">Quest log / 001</p>
      <h1 id="projects-title" class="identity-title text-[color:var(--ink)]">PROJECTS</h1>
      <p class="section-copy mt-6 max-w-xl">Two things I have been building for people who prefer useful tools with a little character.</p>
    </header>

    <div class="project-grid mt-8">
      <article class="bento-card project-card">
        <div class="media-panel project-art" aria-hidden="true"><span>FM</span></div>
        <div class="project-copy">
          <p class="eyebrow">001 / terminal tool</p>
          <h2>gridfm</h2>
          <p class="section-copy">A keyboard-first file manager that turns the filesystem into a responsive grid of visual cards, with optional terminal image thumbnails.</p>
          <p class="project-stack">GO / TUI / KITTY GRAPHICS</p>
          <a class="text-link" href="https://github.com/ilyaryabchinski/gridfm" rel="noreferrer"><span>VIEW ON GITHUB</span></a>
        </div>
      </article>

      <article class="bento-card project-card">
        <div class="media-panel project-art project-art-polish" aria-hidden="true"><span>PL</span></div>
        <div class="project-copy">
          <p class="eyebrow">002 / browser extension</p>
          <h2>Polish</h2>
          <p class="section-copy">A Chrome extension for correcting selected text through an OpenAI-compatible API, right where you are writing.</p>
          <p class="project-stack">TYPESCRIPT / CHROME / AI API</p>
          <a class="text-link" href="https://github.com/ilyaryabchinski/polish" rel="noreferrer"><span>VIEW ON GITHUB</span></a>
        </div>
      </article>
    </div>

    <a class="pixel-button project-back inline-flex" href="/">BACK HOME</a>
  </section>
</Layout>

<style>
  .project-page-header { padding: 24px 0; }
  .project-page-header h1 { margin-top: 16px; }
  .project-grid { display: grid; gap: 24px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .project-card { display: flex; flex-direction: column; min-height: 28rem; overflow: hidden; }
  .project-art { aspect-ratio: 16 / 9; border: 0; border-bottom: var(--pixel) solid var(--ink); min-height: 0; }
  .project-art::after { border-width: 8px; height: 40%; transform: rotate(0deg); width: 42%; }
  .project-art-polish::after { border-width: 0 8px 8px 0; transform: rotate(45deg); }
  .project-copy { display: flex; flex: 1; flex-direction: column; gap: 12px; padding: 20px; }
  .project-copy h2 { font-size: 1rem; }
  .project-stack { color: var(--ink-muted); font-family: "Press Start 2P", monospace; font-size: .45rem; line-height: 1.7; }
  .project-copy .text-link { margin-top: auto; }
  .project-back.pixel-button { margin-top: 48px; }
  @media (max-width: 767px) {
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
